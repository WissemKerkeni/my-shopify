<section class="ag-cta color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width ag-cta__inner">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="ag-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ag-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="ag-cta__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if section.settings.btn_label != blank -%}<a class="ag-btn ag-btn--gold" href="{{ section.settings.btn_link }}">{{ section.settings.btn_label }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
  </div>
</section>
{% schema %}
{"name":"AG Appel à l'action","settings":[{"type":"color_scheme","id":"color_scheme","label":"Couleurs","default":"scheme-2"},{"type":"text","id":"eyebrow","label":"Surtitre"},{"type":"text","id":"heading","label":"Titre","default":"Titre"},{"type":"textarea","id":"text","label":"Texte"},{"type":"text","id":"btn_label","label":"Bouton"},{"type":"url","id":"btn_link","label":"Lien"}],"presets":[{"name":"AG Appel à l'action"}]}
{% endschema %}