<section class="ag-benefits color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="ag-head">
      {%- if section.settings.eyebrow != blank -%}<p class="ag-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ag-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="ag-head__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="ag-benefits__grid">
      {%- for block in section.blocks -%}
        <div class="ag-benefit" {{ block.shopify_attributes }}>
          <span class="ag-benefit__icon">{% render 'ag-icon', icon: block.settings.icon, size: 28 %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"AG Bénéfices","settings":[{"type":"color_scheme","id":"color_scheme","label":"Couleurs","default":"scheme-1"},{"type":"text","id":"eyebrow","label":"Surtitre"},{"type":"text","id":"heading","label":"Titre","default":"Titre"},{"type":"textarea","id":"text","label":"Texte"}],"blocks":[{"type":"benefit","name":"Bénéfice","settings":[{"type":"select","id":"icon","label":"Icône","options":[{"value":"truck","label":"Camion"},{"value":"return","label":"Retour"},{"value":"lock","label":"Cadenas"},{"value":"card","label":"Carte"},{"value":"shield","label":"Bouclier"},{"value":"snow","label":"Flocon"},{"value":"mountain","label":"Montagne"},{"value":"feather","label":"Plume"},{"value":"flame","label":"Flamme"},{"value":"chat","label":"Message"},{"value":"check","label":"Coche"},{"value":"star","label":"Etoile"}],"default":"shield"},{"type":"text","id":"title","label":"Titre","default":"Titre"},{"type":"textarea","id":"text","label":"Texte"}]}],"max_blocks":4,"presets":[{"name":"AG Bénéfices"}]}
{% endschema %}