<section class="ag-hero ag-hero--{{ section.settings.layout }}" style="--ag-h:{{ section.settings.height }}vh;--ag-o:{{ section.settings.overlay | divided_by: 100.0 }};--ag-pos:{{ section.settings.focal }}">
  <div class="ag-hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400', alt: section.settings.image.alt }}
    {%- endif -%}
  </div>
  <div class="ag-hero__overlay"></div>
  <div class="page-width ag-hero__inner">
    <div class="ag-hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="ag-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- liquid
        assign ag_title = section.settings.heading
        if section.settings.highlight != blank
          assign ag_hl = '<span class="ag-hl">' | append: section.settings.highlight | append: '</span>'
          assign ag_title = ag_title | replace: section.settings.highlight, ag_hl
        endif
      -%}
      <h1 class="ag-hero__title">{{ ag_title }}</h1>
      {%- if section.settings.text != blank -%}<p class="ag-hero__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="ag-hero__ctas">
        {%- if section.settings.btn1_label != blank -%}<a class="ag-btn ag-btn--gold" href="{{ section.settings.btn1_link }}">{{ section.settings.btn1_label }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a class="ag-btn ag-btn--ghost" href="{{ section.settings.btn2_link }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
      <ul class="ag-hero__trust" role="list">
        {%- if section.settings.trust1 != blank -%}<li>{% render 'ag-icon', icon: 'check', size: 18 %}<span>{{ section.settings.trust1 }}</span></li>{%- endif -%}
        {%- if section.settings.trust2 != blank -%}<li>{% render 'ag-icon', icon: 'check', size: 18 %}<span>{{ section.settings.trust2 }}</span></li>{%- endif -%}
        {%- if section.settings.trust3 != blank -%}<li>{% render 'ag-icon', icon: 'check', size: 18 %}<span>{{ section.settings.trust3 }}</span></li>{%- endif -%}
      </ul>
    </div>
  </div>
</section>
{% schema %}
{"name":"AG Héro","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"layout","label":"Mise en page","options":[{"value":"full","label":"Image plein écran"},{"value":"split","label":"Texte à gauche, image à droite"}],"default":"full"},{"type":"text","id":"focal","label":"Point focal","default":"center"},{"type":"range","id":"height","label":"Hauteur (vh)","min":50,"max":100,"step":2,"default":84},{"type":"range","id":"overlay","label":"Voile (%)","min":0,"max":100,"step":5,"default":85},{"type":"text","id":"eyebrow","label":"Surtitre"},{"type":"text","id":"heading","label":"Titre","default":"Titre"},{"type":"text","id":"highlight","label":"Mots en couleur (copiés du titre)"},{"type":"textarea","id":"text","label":"Texte"},{"type":"text","id":"btn1_label","label":"Bouton 1"},{"type":"url","id":"btn1_link","label":"Lien 1"},{"type":"text","id":"btn2_label","label":"Bouton 2"},{"type":"url","id":"btn2_link","label":"Lien 2"},{"type":"text","id":"trust1","label":"Réassurance 1"},{"type":"text","id":"trust2","label":"Réassurance 2"},{"type":"text","id":"trust3","label":"Réassurance 3"}],"presets":[{"name":"AG Héro"}]}
{% endschema %}