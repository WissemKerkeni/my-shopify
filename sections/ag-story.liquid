<section class="ag-story color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width ag-story__grid{% if section.settings.image_right %} ag-story__grid--rev{% endif %}">
    <div class="ag-story__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
      {%- endif -%}
      {%- if section.settings.tag != blank -%}<span class="ag-story__tag">{{ section.settings.tag }}</span>{%- endif -%}
    </div>
    <div class="ag-story__content">
      {%- if section.settings.eyebrow != blank -%}<p class="ag-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ag-h2">{{ section.settings.heading }}</h2>
      <div class="ag-story__text">{{ section.settings.text }}</div>
      {%- if section.blocks.size > 0 -%}
        <ul class="ag-stats" role="list">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span class="ag-stats__num">{{ block.settings.number }}</span><span class="ag-stats__label">{{ block.settings.label }}</span></li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.btn_label != blank -%}<a class="ag-btn ag-btn--gold" href="{{ section.settings.btn_link }}">{{ section.settings.btn_label }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"AG Problème / solution","settings":[{"type":"color_scheme","id":"color_scheme","label":"Couleurs","default":"scheme-2"},{"type":"image_picker","id":"image","label":"Image"},{"type":"checkbox","id":"image_right","label":"Image à droite","default":false},{"type":"text","id":"tag","label":"Étiquette sur l'image"},{"type":"text","id":"eyebrow","label":"Surtitre"},{"type":"text","id":"heading","label":"Titre","default":"Titre"},{"type":"richtext","id":"text","label":"Texte"},{"type":"text","id":"btn_label","label":"Bouton"},{"type":"url","id":"btn_link","label":"Lien"}],"blocks":[{"type":"stat","name":"Chiffre","settings":[{"type":"text","id":"number","label":"Chiffre","default":"60 g"},{"type":"text","id":"label","label":"Légende"}]}],"max_blocks":3,"presets":[{"name":"AG Problème / solution"}]}
{% endschema %}